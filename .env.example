# RefChecker Environment Configuration
# Copy this file to .env and fill in your API keys
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your keys
#   docker compose up

# =============================================================================
# Multi-user Authentication
# Set REFCHECKER_MULTIUSER=true to enable OAuth login.
# Without this, the server runs in single-user mode (no login required).
# =============================================================================
REFCHECKER_MULTIUSER=true

# Secret key used to sign JWT session tokens (HttpOnly cookies).
# IMPORTANT: Set a long random value in production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Public URL of the site (used for CORS and OAuth redirect URIs)
# Example: https://refchecker.example.com
SITE_URL=

# Set to "true" to mark auth cookies as Secure (required for HTTPS deployments)
HTTPS_ONLY=false

# Maximum concurrent reference checks per user (default: 3)
MAX_CHECKS_PER_USER=3

# Comma-separated admin identities (provider-qualified recommended).
# The very first user to sign in is also auto-promoted to admin.
# Example: github:markrussinovich,admin@example.com
REFCHECKER_ADMINS=

# Google OAuth 2.0 credentials
# Create at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: <SITE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Override callback URL (optional, auto-detected from request if blank)
GOOGLE_REDIRECT_URI=

# GitHub OAuth App credentials
# Create at https://github.com/settings/developers
# Callback URL: <SITE_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Override callback URL (optional, auto-detected from request if blank)
GITHUB_REDIRECT_URI=

# Microsoft (Entra ID / Azure AD) OAuth credentials
# Create at https://portal.azure.com → App registrations
# Redirect URI: <SITE_URL>/api/auth/callback/microsoft
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Override callback URL (optional, auto-detected from request if blank)
MS_REDIRECT_URI=

# =============================================================================
# LLM Provider API Keys
# Note: In multi-user mode, API keys are stored in the browser (localStorage)
# and sent per-request. They are never persisted on the server.
# =============================================================================

# Anthropic Claude API Key
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API Key  
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google AI (Gemini) API Key
# Get yours at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=

# =============================================================================
# Optional API Keys
# =============================================================================

# Semantic Scholar API Key (optional)
# For higher rate limits when verifying references.
# CLI and WebUI read this from the server environment; WebUI request/browser keys override it.
# Get yours at: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Springer Nature API Key (optional)
# Enables a final-resort publisher metadata lookup through the Meta API v2.
# It runs only after the normal metadata/catalogue sources do not provide a
# complete result (except explicit "search all databases" runs). A normal
# institutional content login is separate; create an API key at:
# https://dev.springernature.com/
SPRINGER_NATURE_API_KEY=
# Safe free-plan defaults: rolling limits shared across RefChecker processes.
# Increase these only after Springer Nature upgrades the API subscription.
REFCHECKER_SPRINGER_NATURE_MINUTE_LIMIT=90
REFCHECKER_SPRINGER_NATURE_DAILY_LIMIT=450
REFCHECKER_SPRINGER_NATURE_RATE_LIMIT_DELAY=1.0
# Optional override for the persistent, key-hash-only quota state database.
# REFCHECKER_SPRINGER_NATURE_QUOTA_STATE=/path/to/provider_state.sqlite3

# Google Books API Key (optional)
# Enables the final-resort lookup for book citations after all other databases.
# Restrict this key to the Google Books API and, for server deployments, the
# server's IP address. Do not reuse a browser-exposed or Gemini key.
GOOGLE_BOOKS_API_KEY=

# Minimum delay between Google Books requests in seconds (default: 1.0).
# The actual request quota is configured on the key's Google Cloud project.
REFCHECKER_GOOGLE_BOOKS_RATE_LIMIT_DELAY=1.0
REFCHECKER_GOOGLE_BOOKS_INCLUDE_MAGAZINES=true

# Paperclip API Key (optional)
# Enables the secondary biomedical full-text + arXiv verification tier.
# CLI and WebUI read this from the server environment; WebUI request/browser keys override it.
# Get yours at: https://paperclip.gxl.ai/keys
PAPERCLIP_API_KEY=

# HuggingFace Token (for GPU variant with gated models)
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=

# =============================================================================
# Advanced Configuration
# =============================================================================

# Data directory inside container (default: /app/data)
# REFCHECKER_DATA_DIR=/app/data
